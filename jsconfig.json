{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "skipLibCheck": true,
    "strict": false,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "paths": {
      "three": ["node_modules/three/build/three.module.js"],
      "three/addons/*": ["node_modules/three/examples/jsm/*"]
    }
  },
  "include": ["src/*.js", "tests/*.js"],
  "exclude": ["node_modules", "dist", "tools"]
}